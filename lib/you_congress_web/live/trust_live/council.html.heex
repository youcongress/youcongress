<div
  id="council-editor"
  class="council-ui"
  phx-hook="CouncilDraft"
  data-guest={to_string(is_nil(@current_user))}
  data-readonly="false"
>
  <div class={["yc-content", @step in ["publish", "invite"] && "narrow"]}>
    <.steps :if={@step in ["pick", "join", "publish", "invite"]} step={@step} />
    <div :if={@referrer && @step == "landing"} class="yc-success">
      <.avatar person={@referrer} />
      <div>
        <strong>{@referrer.name} invited you to YouCongress.</strong>
        <p>Who would you choose for your Council?</p>
      </div>
    </div>
    <section :if={@step == "landing"}>
      <div class="yc-hero">
        <div>
          <p class="yc-eyebrow">People you trust. A voice that counts.</p>
          <h1>
            {if @current_user,
              do: "Who’s on your Council?",
              else: "You don’t have to decide alone."}
          </h1>
          <p class="yc-intro">
            Choose the people whose judgment you trust. Your Council represents you on statements you haven’t voted on. Your own vote always comes first.
          </p>
          <div class="yc-row yc-gap">
            <.link patch={~p"/council?#{%{step: "pick"}}"} class="yc-btn primary large">
              Pick my Council →
            </.link>
            <.link
              :if={YouCongress.Accounts.admin?(@current_user)}
              navigate={~p"/trust"}
              class="yc-link"
            >
              Explore Trust 30
            </.link>
          </div>
          <p class="yc-help">
            {if @current_user,
              do: "One Council across every statement. Change your picks anytime.",
              else: "Start choosing now. Create an account when you’re ready to save."}
          </p>
        </div>
        <div class="yc-hero-list">
          <div class="yc-between">
            <h3>Discover people you might trust</h3>
            <span :if={YouCongress.Accounts.admin?(@current_user)} class="yc-badge">
              Trust 30
            </span>
          </div>
          <div :if={@matches != []} class="yc-list yc-gap">
            <div :for={person <- Enum.take(@matches, 3)} class="yc-list-item">
              <.person person={person} subtitle={biography(person)} />
            </div>
          </div>
          <div :if={@matches == []} class="yc-panel yc-gap">
            <h3>Find your Council</h3>
            <p class="yc-gap-sm">
              Search for people whose judgment you value. Choose people whose judgment you value.
            </p>
          </div>
          <p class="yc-help">
            One Council, across all statements. You can choose anyone on YouCongress.
          </p>
        </div>
      </div>
      <div class="yc-three yc-how">
        <div>
          <p class="yc-eyebrow">01 / Choose</p>
          <h3>Whose judgment do you trust?</h3>
          <p class="yc-gap-sm">Find people you trust and add an optional reason for each pick.</p>
        </div>
        <div>
          <p class="yc-eyebrow">02 / Publish</p>
          <h3>Let others see your thinking.</h3>
          <p class="yc-gap-sm">
            Add a reason for each pick. Publish a named list if you’d like to share your picks.
          </p>
        </div>
        <div>
          <p class="yc-eyebrow">03 / Invite</p>
          <h3>Invite thoughtful people.</h3>
          <p class="yc-gap-sm">
            Invite friends to choose their own Council and share the people they value.
          </p>
        </div>
      </div>
      <div :if={YouCongress.Accounts.admin?(@current_user)} class="yc-panel yc-gap-lg yc-between">
        <div>
          <h3>YouCongress Trust 30</h3>
          <p class="yc-help">See who people trust, why they chose them, and where they stand.</p>
        </div>
        <.link
          :if={YouCongress.Accounts.admin?(@current_user)}
          navigate={~p"/trust"}
          class="yc-btn"
        >
          See the Trust List →
        </.link>
      </div>
    </section>

    <section :if={@step == "pick"}>
      <p :if={@source_list_name} class="yc-panel soft yc-gap">
        Copied people from <strong>{@source_list_name}</strong>. Review before saving: saving replaces your private Council. The public list stays unchanged.
      </p>
      <p class="yc-eyebrow">Your Council</p>
      <h1>Whose judgment do you trust?</h1>
      <p class="yc-intro">
        Start with people you would turn to for a thoughtful opinion. You can add or remove anyone later.
      </p>
      <div class="yc-mobile-continue">
        <strong>{length(members(@draft))} selected</strong><.continue_button editing_reason={
          @editing_reason
        }>Continue →</.continue_button>
      </div>
      <div class="yc-grid yc-gap">
        <section>
          <form phx-change="search" phx-submit="search">
            <label for="person-search" class="yc-label">Find a person</label>
            <input
              id="person-search"
              class="yc-field"
              name="q"
              value={@query}
              placeholder="Search by name"
              phx-debounce="250"
            />
          </form>
          <div class="yc-between yc-gap">
            <h3>{if @query == "", do: "People to consider", else: "Search results"}</h3>
            <.link
              :if={YouCongress.Accounts.admin?(@current_user)}
              navigate={~p"/trust"}
              class="yc-link"
            >
              View Trust List
            </.link>
          </div>
          <% candidates = Enum.reject(@matches, &selected?(@draft, &1.id)) %>
          <p
            :if={@last_added_id && selected?(@draft, @last_added_id)}
            class="yc-help"
            role="status"
          >
            {@people[@last_added_id].name} added to your Council.
            <button
              type="button"
              class="yc-link"
              phx-click="edit-reason"
              phx-value-id={@last_added_id}
            >
              + Add a reason
            </button>
          </p>
          <div id="council-candidates" class="yc-list yc-gap-sm">
            <div
              :for={person <- candidates}
              id={"council-candidate-#{person.id}"}
              class="yc-list-item yc-between"
              phx-remove={
                JS.hide(
                  transition: {"yc-picker-fade", "yc-picker-visible", "yc-picker-hidden"},
                  time: 180
                )
              }
            >
              <.person
                person={person}
                subtitle={
                  if YouCongress.Accounts.admin?(@current_user) && @ranks[person.id],
                    do: "#{@ranks[person.id].count} Councils",
                    else: biography(person)
                }
              />
              <button
                type="button"
                class="yc-btn"
                phx-click="add-person"
                phx-value-id={person.id}
                phx-disable-with="Adding…"
                aria-label={"Add #{person.name} to your Council"}
              >
                + Add
              </button>
            </div>
            <p :if={candidates == []} class="yc-list-item">
              {cond do
                @matches != [] ->
                  "Everyone shown is already in your Council. Search for someone else."

                @query == "" ->
                  "Search by name to choose your first Council members."

                true ->
                  "No people found. Try another name."
              end}
            </p>
          </div>
          <p class="yc-help">
            Can’t find someone?
            <.link navigate={~p"/trust/requests"} class="yc-link">Suggest a missing person</.link>
            or invite them after saving.
          </p>
        </section>
        <aside class="yc-stack">
          <div class="yc-panel">
            <div class="yc-between">
              <h3>Your Council</h3>
              <span class="yc-badge purple">{length(members(@draft))} selected</span>
            </div>
            <div class="yc-stack yc-gap">
              <div :for={member <- members(@draft)} id={"council-member-#{member.author_id}"}>
                <div class="yc-between">
                  <.person person={@people[member.author_id]} />
                  <button
                    type="button"
                    class="yc-link muted"
                    phx-click="remove-person"
                    phx-value-id={member.author_id}
                    aria-label={"Remove #{@people[member.author_id].name}"}
                  >
                    Remove
                  </button>
                </div>
                <.reason_editor
                  member={member}
                  person={@people[member.author_id]}
                  editing_reason={@editing_reason}
                  reason_text={@reason_text}
                  reason_error={@reason_error}
                />
              </div>
            </div>
            <p :if={members(@draft) == []} class="yc-gap">Your picks will appear here.</p>
            <hr class="yc-divider" />
            <p class="yc-help">
              Add an optional reason for each person. Reasons stay private unless you publish a copy.
            </p>
            <p class="yc-help">
              Continuing saves your Council and enables its votes. You can choose whether to publish next.
            </p>
            <p :if={members(@draft) == []} class="yc-help">
              Continuing with no people removes your Council members and stops Council votes.
            </p>
            <.continue_button editing_reason={@editing_reason} class="yc-btn primary full yc-gap">
              Continue to Publish →
            </.continue_button>
          </div>
          <div class="yc-panel soft">
            <h3>You stay in control</h3>
            <p class="yc-gap-sm">
              When you haven’t voted, your vote follows your Council’s majority. Your direct vote overrides it.
            </p>
            <p class="yc-help">
              Saving enables Council votes. Nothing changes while you’re choosing.
            </p>
          </div>
        </aside>
      </div>
    </section>

    <section :if={@step == "join"} class="yc-grid equal">
      <div>
        <p class="yc-eyebrow">One last step to save</p>
        <h1>Keep your Council.</h1>
        <p class="yc-intro">
          Create an account to save your {length(members(@draft))} picks. Your reasons will come with you.
        </p>
        <div class="yc-panel soft yc-gap">
          <div class="yc-row">
            <.avatar :for={member <- members(@draft)} person={@people[member.author_id]} />
          </div>
          <p class="yc-gap-sm">
            Your Council stays private. You can publish separate, named lists of people.
          </p>
        </div>
        <.link patch={~p"/council?#{%{step: "pick"}}"} class="yc-link yc-gap">
          ← Back to my picks
        </.link>
      </div>
      <div class="yc-panel">
        <h2>Join YouCongress</h2>
        <p class="yc-gap-sm">Confirm your email to save your Council and start participating.</p>
        <YouCongressWeb.Components.LoginButtons.render
          class="yc-gap"
          email_action={:sign_up}
          pending_actions={pending(@draft, @ref)}
          return_to={~p"/council?#{%{step: "publish"}}"}
        />
        <p class="yc-help yc-gap">
          Already a member?
          <.link
            href={
              YouCongressWeb.ReturnTo.log_in_path(
                pending(@draft, @ref),
                ~p"/council?#{%{step: "publish"}}"
              )
            }
            class="yc-link"
          >
            Log in and keep my picks
          </.link>
        </p>
      </div>
    </section>

    <section :if={@step == "publish" && @current_user}>
      <div class="yc-success">
        <span class="yc-check">✓</span>
        <div>
          <strong>Your Council is saved.</strong>
          <p>Your Council stays private. Publishing a list is optional.</p>
        </div>
      </div>
      <h1 class="yc-gap-lg">Share a named list?</h1>
      <p class="yc-intro">
        Publish a copy of your picks and reasons under a name you choose. Your Council stays private: public lists never show whether you use them to vote.
      </p>
      <form id="publish-council-list" phx-submit="publish-list">
        <label class="yc-label yc-gap" for="council-list-name">List name</label>
        <input
          id="council-list-name"
          class="yc-field"
          name="name"
          placeholder="e.g. People whose judgment I value"
          required
          maxlength="120"
        />
        <div class="yc-panel soft yc-gap">
          <.person
            person={@current_user.author}
            subtitle={"#{people_count(length(members(@draft)))} · reasons included"}
          />
          <div class="yc-row yc-gap-sm">
            <.avatar :for={member <- members(@draft)} person={@people[member.author_id]} />
          </div>
        </div>
        <p class="yc-help yc-gap">
          This creates a separate public list. Future edits to your Council and this list are independent. You can create more lists from My lists.
        </p>
        <div class="yc-actions">
          <.link patch={~p"/council?#{%{step: "invite"}}"} class="yc-link muted">
            Skip for now
          </.link>
          <button class="yc-btn primary" phx-disable-with="Publishing…">
            Publish list & continue →
          </button>
        </div>
      </form>
    </section>

    <section :if={@step == "invite" && @current_user}>
      <div class="yc-success">
        <span class="yc-check">✓</span>
        <div>
          <strong>Your Council is set.</strong>
          <p>
            Your Council stays private. Invite others to choose their own.
          </p>
        </div>
      </div>
      <h1 class="yc-gap-lg">Who would you invite?</h1>
      <p class="yc-intro">
        Invite people whose judgment you value. Every new Council helps more people discover who to trust.
      </p>
      <div :if={@published_list} class="yc-panel soft yc-gap">
        <h3>Your public list: {@published_list.name}</h3>
        <.link navigate={~p"/lists/#{@published_list.id}"} class="yc-link yc-gap-sm">
          View and share your list →
        </.link>
      </div>
      <form id="council-invites" phx-change="invite-change" phx-submit="invite">
        <div class="yc-panel yc-gap">
          <label class="yc-label" for="invite-link">Your personal invite link</label>
          <div class="yc-copy-row">
            <input class="yc-field" id="invite-link" readonly value={invite_url(@current_user)} />
            <button
              type="button"
              class="yc-btn primary"
              data-council-copy={invite_url(@current_user)}
            >
              Copy link
            </button>
          </div>
          <div class="yc-row yc-gap-sm">
            <.link href={share_href(:email, @current_user, @invite_note)} class="yc-btn">
              Email
            </.link>
            <.link href={share_href(:sms, @current_user, @invite_note)} class="yc-btn">
              Messages
            </.link>
            <.link
              href={share_href(:x, @current_user, @invite_note)}
              target="_blank"
              rel="noopener noreferrer"
              class="yc-btn"
            >
              X Post
            </.link>
            <button
              type="button"
              class="yc-btn"
              data-council-share={@invite_note <> "\n\n" <> invite_url(@current_user)}
            >
              Share…
            </button>
          </div>
          <label class="yc-label yc-gap" for="invite-note">
            Add a personal note <span class="yc-muted">· optional</span>
          </label>
          <textarea
            class="yc-field"
            name="note"
            id="invite-note"
            rows="3"
            maxlength="2000"
            phx-debounce="300"
          >{@invite_note}</textarea>
          <p class="yc-help">
            Friends can choose to share named public lists. Their Councils stay private.
          </p>
        </div>
        <div class="yc-panel yc-gap">
          <div class="yc-between">
            <label for="invite-emails" class="yc-label">Invite by email</label><small>One email. No follow-ups.</small>
          </div>
          <input
            class="yc-field"
            id="invite-emails"
            name="emails"
            value={@invite_emails}
            placeholder="Email addresses, separated by commas"
            maxlength="2600"
          />
          <p class="yc-help">Up to 10 people at once, 20 per day.</p>
          <button class="yc-btn purple yc-gap-sm" phx-disable-with="Queuing invitations…">
            Send invites
          </button>
        </div>
      </form>
      <div class="yc-panel soft yc-gap">
        <h3>Your invitations</h3>
        <p class="yc-gap-sm">{@joined} people joined through your invite link.</p>
        <div :for={invitation <- @invitations} class="yc-between yc-gap-sm">
          <span class="yc-break">{invitation.email}</span><span class="yc-badge">{invitation.status}</span>
        </div>
        <p :if={@invitations == []} class="yc-help">No email invitations sent yet.</p>
      </div>
      <div class="yc-actions">
        <.link patch={~p"/council"} class="yc-link muted">Skip for now</.link><.link
          patch={~p"/council"}
          class="yc-btn primary"
        >Go to My Council →</.link>
      </div>
    </section>

    <section :if={@step in ["mine", "votes"]}>
      <div class="yc-between">
        <div class="yc-person">
          <.avatar person={@current_user.author} large />
          <div>
            <h1>My Council</h1>
            <div class="yc-row yc-gap-sm">
              <span class="yc-muted">
                {@current_user.author.name}
              </span>
              <span class="yc-badge">Private Council</span>
            </div>
          </div>
        </div>
        <.link navigate={~p"/lists/new?from=council"} class="yc-btn">Publish a list</.link>
      </div>
      <nav class="yc-tabs" aria-label="My Council">
        <.link patch={~p"/council"} class={@step == "mine" && "active"}>Council</.link><.link
          patch={~p"/council?#{%{step: "votes"}}"}
          class={@step == "votes" && "active"}
        >My votes</.link><.link patch={~p"/council?#{%{step: "invite"}}"}>Invites</.link>
      </nav>
      <div :if={@step == "votes"} class="yc-list yc-gap">
        <div :for={vote <- @votes} class="yc-list-item yc-between">
          <.link navigate={~p"/p/#{vote.statement.slug}"} class="yc-name">
            {vote.statement.title}
          </.link>
          <span class="yc-badge">
            {answer(vote.answer)} · {if vote.direct, do: "direct vote", else: "via your Council"}
          </span>
        </div>
        <p :if={@votes == []} class="yc-list-item">
          No votes yet.
          <.link navigate={~p"/explore"} class="yc-link">Explore statements →</.link>
        </p>
      </div>
      <div :if={@step == "mine"} class="yc-grid yc-gap">
        <section>
          <div class="yc-between">
            <h2>{people_count(length(members(@draft)))} I trust</h2>
            <.link patch={~p"/council?#{%{step: "pick"}}"} class="yc-btn">
              Edit Council
            </.link>
          </div>
          <div class="yc-list yc-gap">
            <div
              :for={member <- members(@draft)}
              id={"council-member-#{member.author_id}"}
              class="yc-list-item"
            >
              <div class="yc-between">
                <.person
                  person={@people[member.author_id]}
                  subtitle={biography(@people[member.author_id])}
                />
                <.link
                  :if={YouCongress.Accounts.admin?(@current_user) && @ranks[member.author_id]}
                  navigate={~p"/trust/people/#{member.author_id}"}
                  class="yc-link"
                >
                  #{@ranks[member.author_id].rank} in Trust 30
                </.link>
              </div>
              <.reason_editor
                member={member}
                person={@people[member.author_id]}
                editing_reason={@editing_reason}
                reason_text={@reason_text}
                reason_error={@reason_error}
              />
              <div class="yc-row yc-gap-sm">
                <.link navigate={~p"/a/#{member.author_id}"} class="yc-link">
                  View positions →
                </.link>
              </div>
            </div>
            <p :if={members(@draft) == []} class="yc-list-item">No people selected yet.</p>
          </div>
          <div class="yc-empty yc-gap yc-between">
            <span>Add someone whose judgment you trust.</span><.link
              patch={~p"/council?step=pick"}
              class="yc-link"
            >Find people →</.link>
          </div>
        </section>
        <aside class="yc-stack">
          <div class="yc-panel">
            <h3>What this Council does</h3>
            <p class="yc-gap-sm">
              On statements you haven’t voted on, the vote follows this Council’s majority. A direct vote always comes first.
            </p>
            <div class="yc-stat-grid yc-gap">
              <div>
                <strong>{@counts.direct}</strong>
                <p>direct votes</p>
              </div>
              <div>
                <strong>{@counts.council}</strong>
                <p>via your Council</p>
              </div>
            </div>
            <p class="yc-help">A tie or no eligible positions means no Council vote.</p>
          </div>
          <div :if={YouCongress.Accounts.admin?(@current_user)} class="yc-panel">
            <h3>Part of YouCongress Trust 30</h3>
            <p class="yc-gap-sm">
              These picks help shape the single Trust List for everyone on YouCongress.
            </p>
            <.link
              :if={YouCongress.Accounts.admin?(@current_user)}
              navigate={~p"/trust"}
              class="yc-link yc-gap-sm"
            >
              View the Trust List →
            </.link>
          </div>
          <div class="yc-panel">
            <h3>Your Council is private</h3>
            <p class="yc-gap-sm">
              Only you can see your Council and its reasons. Public lists do not show whether you use their people to vote.
            </p>
            <.link navigate={~p"/lists"} class="yc-link yc-gap-sm">
              Manage my public lists →
            </.link>
          </div>
          <div class="yc-panel tint">
            <h3>Invite thoughtful people</h3>
            <p class="yc-gap-sm">Whose judgment would you love to hear?</p>
            <.link
              navigate={~p"/council?#{%{step: "invite"}}"}
              class="yc-btn yc-gap-sm"
            >
              Invite friends →
            </.link>
          </div>
        </aside>
      </div>
    </section>
    <p id="council-copy-status" class="yc-help" role="status" phx-update="ignore"></p>
  </div>
</div>
