<main
  id="ai-policy"
  phx-hook="SessionLogin"
  class="overflow-x-hidden text-zinc-700 scroll-smooth"
>
  <div class="border-b border-amber-300 bg-amber-100 px-6 py-2 text-center text-sm font-medium text-amber-900">
    Private preview — please don’t post or share this page publicly before Tuesday, September 8.
    Personal invitations are welcome.
  </div>

  <header class="sticky top-0 z-50 border-b border-zinc-200 bg-white/90 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
      <a href="#top" class="flex items-center gap-2 text-zinc-900">
        <span class="text-lg font-bold">YouCongress</span>
        <span class="rounded-full border border-[#f4d6c6] bg-[#fbeee7] px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-[#8f2c00]">
          AI Policy Group
        </span>
      </a>
      <div class="flex items-center gap-4 text-sm font-medium md:gap-6">
        <nav class="hidden items-center gap-6 md:flex">
          <a href="#focus" class="hover:text-brand">Focus</a><a
            href="#why-now"
            class="hover:text-brand"
          >Why now</a><a href="#sessions" class="hover:text-brand">Sessions</a><a
            href="#process"
            class="hover:text-brand"
          >Process</a>
        </nav>
        <a :if={!@current_user} href={@log_in_href} class="hover:text-brand">Log in</a>
        <.link :if={@current_user} href={~p"/log_out"} method="delete" class="hover:text-brand">
          Log out
        </.link>
        <a href="#register" class="rounded-lg bg-brand px-4 py-2 text-white hover:bg-[#a63300]">
          Register
        </a>
      </div>
    </div>
  </header>

  <section id="top">
    <div class="mx-auto max-w-7xl px-6 pb-20 pt-4 md:pb-24 md:pt-6">
      <div class="max-w-4xl">
        <p class="mb-6 flex items-center gap-2 text-[13px] font-semibold text-[#8f2c00]">
          <span class="h-2 w-2 rounded-full bg-brand"></span>A global online community, starting in Europe
        </p>
        <h1 class="text-5xl font-extrabold leading-none tracking-tight text-zinc-900 md:text-7xl">
          100 AI Policies<br />We Can Agree On
        </h1>
        <p class="mt-7 max-w-2xl text-xl leading-relaxed">
          Join people across Europe and beyond to find practical AI policies on jobs, governance, safety, shared prosperity and sovereignty, and bring the strongest ideas into election debates.
        </p>
        <p class="mt-4 max-w-2xl leading-relaxed text-zinc-500">
          You don't need to be an AI expert or speak perfect English. Work on this with fellow Europeans and people worldwide.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="#register"
            class="rounded-lg bg-brand px-7 py-3.5 font-semibold text-white hover:bg-[#a63300]"
          >
            Register your interest
          </a>
          <a
            href="#focus"
            class="rounded-lg border border-zinc-300 px-7 py-3.5 font-semibold text-zinc-900 hover:bg-zinc-50"
          >
            Read the mission
          </a>
        </div>
        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-zinc-200 pt-6 text-sm text-zinc-500">
          <span><b class="text-xl text-zinc-900">~60</b> minute sessions</span><span><b class="text-xl text-zinc-900">3–7</b> people per group</span><span><b class="text-xl text-zinc-900">EN</b> shared language</span>
        </div>
      </div>
    </div>
  </section>

  <section id="focus" class="bg-zinc-900 text-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="mb-4 text-xs font-bold uppercase tracking-widest text-[#f0a882]">Our mission</p>
      <blockquote class="max-w-5xl text-3xl font-semibold leading-snug md:text-[34px]">
        Find practical AI policies we can broadly agree on, and organize to make them politically actionable, around three questions:
      </blockquote>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <.focus_card number="01" title="AI, jobs, and shared prosperity">
          How can we manage automation, help people adapt, create good jobs, and ensure the benefits of AI are broadly shared?
        </.focus_card>
        <.focus_card number="02" title="AI governance and safety">
          How should governments oversee powerful AI systems, protect citizens, assign responsibility, and manage emerging risks?
        </.focus_card>
        <.focus_card number="03" title="Competitiveness & sovereignty">
          How can Europe and other middle-power countries stay competitive and technologically independent?
        </.focus_card>
      </div>
    </div>
  </section>

  <section id="why-now" class="border-y border-[#f0ece7] bg-[#faf8f5]">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 md:grid-cols-2">
      <div>
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-[#8f2c00]">Why now</p>
        <h2 class="text-4xl font-extrabold tracking-tight text-zinc-900">
          AI is changing society before society has chosen the rules
        </h2>
        <p class="mt-5 text-lg leading-relaxed">
          Decisions about work, safety, power, and prosperity are being made now. Most people will
          live with the consequences without ever having a meaningful voice in shaping them.
        </p>
        <div class="mt-7 rounded-xl border border-[#f0c9b5] bg-[#fbeee7] p-5 text-lg font-bold leading-relaxed text-zinc-900">
          AI policy is too important to leave only to a few governments and technology companies.
        </div>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-7">
        <p class="text-xs font-bold uppercase tracking-widest text-zinc-500">Our answer</p>
        <ul class="mt-4 space-y-3">
          <li>→ Develop concrete policy proposals</li>
          <li>→ Document evidence and objections</li>
          <li>→ Identify areas of broad agreement</li>
          <li>→ Ask parties and candidates to respond</li>
          <li>→ Compare their positions transparently</li>
          <li>→ Help participants advocate for supported proposals</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16 text-center text-2xl font-extrabold text-zinc-900 md:text-3xl">
    Global discussion. National policy agendas. Electoral accountability.
    <span class="text-brand">Political action.</span>
  </section>

  <section id="sessions" class="bg-zinc-900 text-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="text-xs font-bold uppercase tracking-widest text-[#f0a882]">
        Small, practical conversations
      </p>
      <h2 class="mt-3 text-4xl font-extrabold">YouCongress AI Policy Sessions</h2>
      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-5">
        <.fact label="Online" detail="join from anywhere" /><.fact
          label="~60 min"
          detail="focused sessions"
        /><.fact label="3–7 people" detail="small groups" /><.fact
          label="English"
          detail="shared language"
        /><.fact label="1 question" detail="at a time" />
      </div>
      <p class="mt-10 text-2xl font-semibold text-[#f0a882]">“More groups, not bigger calls.”</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-14 px-6 py-20 md:grid-cols-2">
    <div>
      <p class="mb-3 text-xs font-bold uppercase tracking-widest text-[#8f2c00]">
        Who can participate
      </p>
      <h2 class="text-3xl font-extrabold text-zinc-900">Everyone who cares, not just experts</h2>
      <p class="mt-5 leading-relaxed">
        A mixture of countries, professions, ages, and political perspectives produces stronger policies.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <%= for label <- ["Technologists & researchers", "Employees, freelancers, job seekers", "Entrepreneurs & business leaders", "Teachers & students", "Policy specialists", "Trade unions & civil society", "Journalists", "Concerned citizens"] do %>
          <span class="rounded-lg border border-[#eee7df] bg-[#faf8f5] px-3 py-2 text-sm text-zinc-800">
            {label}
          </span>
        <% end %>
      </div>
    </div>
    <div class="border-zinc-200 md:border-l md:pl-14">
      <p class="mb-3 text-xs font-bold uppercase tracking-widest text-[#8f2c00]">Why English</p>
      <h2 class="text-3xl font-extrabold text-zinc-900">One shared language</h2>
      <p class="mt-5 leading-relaxed">
        English lets people from different countries participate together and practice discussing complex professional subjects. This is not an English class: good AI policy is the purpose; better professional English is a bonus.
      </p>
    </div>
  </section>

  <section id="process" class="border-y border-[#f0ece7] bg-[#faf8f5]">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="text-xs font-bold uppercase tracking-widest text-[#8f2c00]">
        From discussion to political action
      </p>
      <h2 class="mt-3 max-w-xl text-4xl font-extrabold tracking-tight text-zinc-900">
        How a proposal becomes influence
      </h2>
      <div class="mt-10 grid gap-x-10 md:grid-cols-2">
        <%= for {text, number} <- Enum.with_index(["Someone proposes a specific AI policy.", "Evidence, expert opinions, and objections are collected.", "A small online group discusses and improves it.", "The proposal is published and voted on through YouCongress.", "Policies with broad support enter election-specific agendas.", "Political parties and candidates are invited to respond.", "Their positions are published transparently.", "Participants organize to share supported proposals."], 1) do %>
          <div class="flex gap-4 border-b border-[#ece6df] py-5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold text-white">
              {number}
            </span>
            <span class="pt-1 text-zinc-800">{text}</span>
          </div>
        <% end %>
      </div>
      <p class="mt-9 max-w-3xl leading-relaxed text-zinc-600">
        Steps 2 and 4 don't happen on a whiteboard. They run on YouCongress: an open-source, open-data base of sourced quotes from researchers, officials and public figures, each traceable to where and when it was said, plus voting and delegation, so support for a proposal is visible and can be traced back to the evidence behind it.
      </p>
      <p class="mt-6 max-w-3xl text-lg font-semibold text-zinc-900">
        The objective is not simply to host conversations. It is to turn well-reasoned public agreement into political influence.
      </p>
    </div>
  </section>

  <section id="register" class="border-t border-[#f0ece7] bg-[#faf8f5]">
    <div class="mx-auto grid max-w-7xl gap-14 px-6 py-20 md:grid-cols-[.85fr_1.15fr]">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#8f2c00]">Join us</p>
        <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-zinc-900">
          {if @current_user, do: "Register your interest", else: "Create an account and join"}
        </h2>
        <p class="mt-5 text-lg leading-relaxed">
          Help identify 100 practical policies on jobs, governance, safety, and competitiveness, then bring the strongest ideas into election debates.
        </p>
        <ol class="mt-7 space-y-4 text-sm">
          <li>
            <b class="mr-3 text-brand">01</b> Tell us your country, background, and interests.
          </li>
          <li>
            <b class="mr-3 text-brand">02</b>
            Invite one thoughtful person from a different country or profession.
          </li>
          <li>
            <b class="mr-3 text-brand">03</b>
            Join a small pilot session and start shaping proposals.
          </li>
        </ol>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm md:p-8">
        <%= if @saved do %>
          <div class="py-10 text-center">
            <h3 class="text-2xl font-bold text-zinc-900">You're on the list.</h3>
            <p class="mt-3">
              We sent a six-digit code to your email. Taking you to the confirmation step…
            </p>
            <a href={@confirm_email_href} class="mt-3 inline-block text-brand hover:underline">
              Confirm your email
            </a>
          </div>
        <% else %>
          <%= if !@current_user do %>
            <div class="mb-5 space-y-2">
              <a
                href={@google_href}
                class="flex w-full items-center justify-center rounded-lg border border-zinc-300 px-4 py-2.5 text-sm font-semibold text-zinc-700 hover:bg-zinc-50"
              >
                Sign up with Google
              </a>
              <a
                :if={@log_in_with_x?}
                href={@x_href}
                class="flex w-full items-center justify-center gap-2 rounded-lg border border-zinc-900 bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-zinc-800"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
                Sign up with X
              </a>
              <a
                href={@log_in_href}
                class="block text-center text-sm text-brand hover:underline"
              >
                Already have an account? Log in
              </a>
              <p class="text-center text-xs text-zinc-500">
                After signing in, return here to tell us your country and interests.
              </p>
            </div>
            <div class="relative mb-5 border-t border-zinc-200">
              <span class="absolute left-1/2 -top-3 -translate-x-1/2 bg-white px-2 text-xs text-zinc-500">
                or create an account
              </span>
            </div>
          <% end %>
          <.form
            for={@form}
            id="ai-policy-registration"
            phx-change="validate"
            phx-submit="register-interest"
            class="space-y-5"
          >
            <%= if !@current_user do %>
              <div class="grid gap-5 md:grid-cols-2">
                <.input field={@form[:name]} label="Full name" required /><.input
                  field={@form[:email]}
                  type="email"
                  label="Email"
                  required
                />
              </div>
              <.input field={@form[:password]} type="password" label="Password" required />
              <p class="-mt-3 text-xs text-zinc-500">
                Create a YouCongress account so you can vote and delegate later.
              </p>
            <% else %>
              <div>
                <.label for="current_name">Full name</.label>
                <input
                  type="text"
                  id="current_name"
                  name="current_name"
                  value={@current_user.author.name}
                  disabled
                  class="mt-2 block w-full cursor-not-allowed rounded-lg border-zinc-300 bg-zinc-100 text-zinc-500 focus:ring-0 sm:text-sm sm:leading-6"
                />
              </div>
              <p class="-mt-3 text-xs text-zinc-500">
                <.link navigate={~p"/settings"} class="text-brand hover:underline">
                  Change your name in settings
                </.link>
              </p>
            <% end %>
            <.input
              field={@form[:country_id]}
              type="select"
              label="Country"
              prompt="Select your country"
              options={@countries}
              required
            /><.input
              field={@form[:professional_background]}
              type="select"
              label="Professional background"
              prompt="Select one"
              options={@backgrounds}
            />
            <.input
              field={@form[:linkedin_or_website]}
              label="LinkedIn or website (optional)"
              placeholder="linkedin.com/in/your-profile"
            />
            <fieldset>
              <legend class="mb-2 text-sm font-semibold leading-6 text-zinc-800">
                Interests
              </legend>
              <div class="grid gap-2 sm:grid-cols-3">
                <%= for {label, value} <- @interests do %>
                  <label class="flex items-center gap-2 text-sm">
                    <input
                      type="checkbox"
                      name="signup[interests][]"
                      value={value}
                      checked={value in (@form[:interests].value || [])}
                      class="rounded border-zinc-300 text-brand focus:ring-brand"
                    />{label}
                  </label>
                <% end %>
              </div>
            </fieldset>
            <.input
              field={@form[:availability_and_motivation]}
              type="textarea"
              label="Availability & motivation (optional)"
            />
            <.input
              field={@form[:newsletter]}
              type="checkbox"
              label="Send me occasional emails about features and content"
            />
            <button
              type="submit"
              class="w-full rounded-lg bg-brand px-5 py-3 font-semibold text-white hover:bg-[#a63300]"
              phx-disable-with="Saving…"
            >
              {if @current_user,
                do: "Register my interest",
                else: "Create account & register interest"}
            </button>
          </.form>
        <% end %>
      </div>
    </div>
  </section>

  <section class="bg-zinc-900">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-6 py-16 text-center md:flex-row md:text-left">
      <h2 class="text-3xl font-extrabold text-white">
        Discuss globally. Build agreement. <span class="text-[#f0a882]">Act politically.</span>
      </h2>
      <a
        href="#register"
        class="rounded-lg bg-brand px-6 py-3 font-semibold text-white hover:bg-[#a63300]"
      >
        Register your interest
      </a>
    </div>
  </section>
  <footer class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-6 py-8 text-sm text-zinc-500">
    <span class="font-bold text-zinc-900">YouCongress</span><span class="space-x-4"><a
      href="/about"
      class="hover:text-brand"
    >About</a><a href="/terms" class="hover:text-brand">Terms</a><a
      href="/privacy-policy"
      class="hover:text-brand"
    >Privacy</a><a href="/contact" class="hover:text-brand">Contact</a></span>
  </footer>
</main>
