<div
  id="council-editor"
  class="council-ui"
  phx-hook="CouncilDraft"
  data-guest={to_string(is_nil(@current_user))}
  data-readonly="false"
>
  <div class={["yc-content", @step in ["publish", "invite"] && "narrow"]}>
    <.steps
      :if={@step in ["join", "publish", "invite"] || (@step == "pick" && is_nil(@current_user))}
      step={@step}
    />
    <div :if={@referrer && @step == "landing"} class="yc-success">
      <.avatar person={@referrer} />
      <div>
        <strong>{@referrer.name} invited you to YouCongress.</strong>
        <p>Who would you choose for your Council?</p>
      </div>
    </div>
    <section :if={@step == "landing"}>
      <div class="yc-hero">
        <div>
          <p class="yc-eyebrow">People you trust. A voice that counts.</p>
          <h1>
            {if @current_user,
              do: "Who’s on your Council?",
              else: "You don’t have to decide alone."}
          </h1>
          <p class="yc-intro">
            Choose the people whose judgment you trust. Your Council represents you on statements you haven’t voted on. Your own vote always comes first.
          </p>
          <div class="yc-row yc-gap">
            <.link patch={~p"/council?#{%{step: "pick"}}"} class="yc-btn primary large">
              Pick my Council →
            </.link>
            <.link
              :if={YouCongress.Accounts.admin?(@current_user)}
              navigate={~p"/trust"}
              class="yc-link"
            >
              Explore Trust 30
            </.link>
          </div>
          <p class="yc-help">
            {if @current_user,
              do:
                "Choose people by hall. Entries set to “All statements” apply regardless of hall.",
              else: "Start choosing now. Create an account when you’re ready to save."}
          </p>
        </div>
        <div class="yc-hero-list">
          <div class="yc-between">
            <h3>Discover people you might trust</h3>
            <span :if={YouCongress.Accounts.admin?(@current_user)} class="yc-badge">
              Trust 30
            </span>
          </div>
          <div :if={@matches != []} class="yc-list yc-gap">
            <div :for={person <- Enum.take(@matches, 3)} class="yc-list-item">
              <.person person={person} subtitle={biography(person)} />
            </div>
          </div>
          <div :if={@matches == []} class="yc-panel yc-gap">
            <h3>Find your Council</h3>
            <p class="yc-gap-sm">
              Search for people whose judgment you value. Choose people whose judgment you value.
            </p>
          </div>
          <p class="yc-help">
            Choose different people for different halls. You can choose anyone on YouCongress.
          </p>
        </div>
      </div>
      <div class="yc-three yc-how">
        <div>
          <p class="yc-eyebrow">01 / Choose</p>
          <h3>Whose judgment do you trust?</h3>
          <p class="yc-gap-sm">Find people you trust and add an optional reason for each pick.</p>
        </div>
        <div>
          <p class="yc-eyebrow">02 / Publish</p>
          <h3>Let others see your thinking.</h3>
          <p class="yc-gap-sm">
            Add a reason for each pick. Publish a named list if you’d like to share your picks.
          </p>
        </div>
        <div>
          <p class="yc-eyebrow">03 / Invite</p>
          <h3>Invite thoughtful people.</h3>
          <p class="yc-gap-sm">
            Invite friends to choose their own Council and share the people they value.
          </p>
        </div>
      </div>
      <div :if={YouCongress.Accounts.admin?(@current_user)} class="yc-panel yc-gap-lg yc-between">
        <div>
          <h3>YouCongress Trust 30</h3>
          <p class="yc-help">See who people trust, why they chose them, and where they stand.</p>
        </div>
        <.link
          :if={YouCongress.Accounts.admin?(@current_user)}
          navigate={~p"/trust"}
          class="yc-btn"
        >
          See the Trust List →
        </.link>
      </div>
    </section>

    <p :if={@save_error} class="yc-panel yc-gap text-red-700" role="alert">
      {@save_error} <.link href={~p"/council"} class="yc-link">Reload</.link>
    </p>
    <section :if={@step == "pick" && @current_user} id="council-entry" class="yc-entry">
      <.link patch={~p"/council"} class="yc-link">← My Council</.link>
      <div class="yc-row yc-gap">
        <h1>Edit Council entry</h1>
        <span class="yc-badge">Position {active_index(@draft) + 1} in your Council order</span>
      </div>
      <p class="yc-intro">Choose the hall and the list you want to use.</p>
      <div class="yc-entry-card yc-gap">
        <section class="yc-entry-section">
          <h2>Hall</h2>
          <div class="yc-gap-sm">
            <.live_component
              module={YouCongressWeb.Components.CouncilHallSelector}
              id={"council-edit-hall-#{current_list(@draft).id}"}
              list_id={current_list(@draft).id}
              hall_id={current_list(@draft).hall_id}
              halls={@halls}
              fixed={current_list(@draft).fallback}
            />
          </div>
          <p class="yc-help">
            {if current_list(@draft).hall_id,
              do: "Applies to statements tagged with this hall.",
              else: "Entries set to “All statements” apply regardless of hall."}
          </p>
        </section>
        <section id="council-linked-list" class="yc-entry-section">
          <h2>Selected list</h2>
          <div class="yc-between yc-gap-sm">
            <div>
              <%= if @linked_list do %>
                <div class="yc-row">
                  <h2>{@linked_list.name}</h2>
                  <span class="yc-badge">
                    {if @linked_list.public, do: "Public", else: "Private"}
                  </span>
                </div>
                <p class="yc-help">
                  By {if @linked_list.author_id == @current_user.author_id,
                    do: "you",
                    else: @list_owner.name} · {people_count(length(@linked_list.members))}
                </p>
              <% else %>
                <h3>List unavailable</h3>
                <p class="yc-help">
                  It may have been deleted or made private. This entry is skipped until you choose another list.
                </p>
              <% end %>
            </div>
            <div class="yc-row yc-entry-actions">
              <.link
                :if={@linked_list && @linked_list.author_id == @current_user.author_id}
                navigate={
                  ~p"/lists/#{@linked_list.id}/edit?#{%{from: "council", council_list_id: current_list(@draft).id}}"
                }
                class="yc-btn"
              >
                Edit list
              </.link>
              <button
                :if={@linked_list && @linked_list.author_id != @current_user.author_id}
                type="button"
                phx-click="copy-selected-list"
                class="yc-btn"
              >
                Make a private copy
              </button>
              <button
                type="button"
                phx-click="toggle-public-list-picker"
                class="yc-btn purple"
                aria-expanded={to_string(@show_public_list_picker)}
                aria-controls="council-public-list-picker"
              >
                {if @linked_list, do: "Change list", else: "Choose a list"}
              </button>
            </div>
          </div>
          <p :if={@linked_list} class="yc-help yc-gap-sm">
            {if @linked_list.author_id == @current_user.author_id,
              do: "Changes to this list apply everywhere it is used.",
              else:
                "This list follows its owner’s updates. Make a private copy to edit it independently."}
          </p>
          <div
            :if={@show_public_list_picker}
            id="council-public-list-picker"
            class="yc-entry-picker"
          >
            <div class="yc-between">
              <h3>{if @linked_list, do: "Change list", else: "Choose a list"}</h3>
              <button type="button" class="yc-link" phx-click="toggle-public-list-picker">
                Cancel
              </button>
            </div>
            <form
              id="search-public-lists"
              phx-change="search-public-lists"
              phx-submit="search-public-lists"
              class="space-y-3"
            >
              <label for="public-list-scope" class="yc-label">Browse</label>
              <select id="public-list-scope" name="scope" class="yc-field">
                <option value="mine" selected={@public_list_scope == "mine"}>
                  My lists · Private and public
                </option>
                <option value="all" selected={@public_list_scope == "all"}>
                  Everyone’s public lists
                </option>
              </select>
              <label for="public-list-search" class="yc-label">Find a list or person</label>
              <input
                id="public-list-search"
                name="q"
                value={@public_list_query}
                class="yc-field"
                placeholder="Search by list title or author"
                phx-debounce="250"
              />
            </form>
            <div class="yc-list yc-gap-sm">
              <div
                :for={list <- @public_list_results}
                id={"public-list-option-#{list.id}"}
                class="yc-list-item yc-between"
              >
                <div>
                  <strong>{list.name}</strong>
                  <p class="yc-help">
                    {list.author_name} · {people_count(list.count)} · {if list.public,
                      do: "Public",
                      else: "Private"}
                  </p>
                </div>
                <button
                  type="button"
                  phx-click="preview-public-list"
                  phx-value-id={list.id}
                  class="yc-btn"
                >
                  Select
                </button>
              </div>
              <p :if={@public_list_results == []} class="yc-list-item yc-help">
                No lists found. Try another search or browse everyone’s lists.
              </p>
            </div>
            <button
              :if={length(@public_list_results) == @public_list_limit}
              phx-click="more-public-lists"
              class="yc-link yc-gap-sm"
            >
              Show more lists
            </button>
            <form
              :if={@selected_public_list}
              id="use-public-list"
              phx-submit="apply-public-list"
              class="yc-panel yc-gap-sm"
            >
              <h3>Use {@selected_public_list.name}?</h3>
              <p class="yc-help">
                Uses this list for this Council entry. The hall and order stay the same. The previously selected list is kept.
              </p>
              <.link
                href={~p"/lists/#{@selected_public_list.id}"}
                target="_blank"
                rel="noopener noreferrer"
                class="yc-link"
              >
                View list ↗
              </.link>
              <p class="yc-help yc-gap-sm">
                This uses the actual list. Membership updates by its owner affect your Council. The owner cannot see who uses it.
              </p>
              <label class="block yc-gap-sm">
                <input type="checkbox" name="copy" value="true" /> Make a private copy instead
                <span class="block yc-help">
                  A copy belongs to you and changes independently.
                </span>
              </label>
              <button class="yc-btn purple yc-gap-sm">Use this list</button>
            </form>
            <form
              id="create-council-private-list"
              phx-submit="create-private-list"
              class="yc-panel yc-gap-sm"
            >
              <label for="new-private-list-name" class="yc-label">
                Or create a new private list
              </label>
              <input
                id="new-private-list-name"
                name="name"
                class="yc-field"
                required
                maxlength="120"
                placeholder="Give your list a name"
              />
              <button class="yc-btn yc-gap-sm">Create and select list</button>
            </form>
          </div>

          <div :if={@linked_list} class="yc-entry-preview yc-gap">
            <p class="yc-eyebrow">People in this list</p>
            <div :for={member <- Enum.take(@linked_list.members, 5)} class="yc-entry-person">
              <.person person={@preview_people[member.author_id]} />
            </div>
            <p :if={@linked_list.members == []} class="yc-help yc-gap-sm">
              This list is empty. Choose another list, or add people in the list editor if you own it.
            </p>
            <p :if={length(@linked_list.members) > 5} class="yc-help">
              And {length(@linked_list.members) - 5} more
            </p>
            <.link
              navigate={YouCongressWeb.PeopleListPaths.public_path(@linked_list)}
              class="yc-link yc-gap-sm"
            >
              View list →
            </.link>
          </div>
        </section>
      </div>
      <p class="yc-help yc-gap">
        Your Council choices stay private, even when you use a public list.
      </p>
      <div class="yc-between yc-gap">
        <.link patch={~p"/council"} class="yc-btn">← Back to My Council</.link>
        <span :if={!@save_error} class="yc-entry-saved" role="status">✓ All changes saved</span>
      </div>
    </section>

    <section :if={@step == "pick" && is_nil(@current_user)}>
      <p :if={@source_list_name} class="yc-panel soft yc-gap">
        Copied people from <strong>{@source_list_name}</strong>. Review your choices before saving.
      </p>
      <p class="yc-eyebrow">Your Council</p>
      <h1>Who do you trust on {current_list(@draft).name}?</h1>
      <p class="yc-intro">Start with people you would turn to for a thoughtful opinion.</p>
      <nav class="yc-topic-tabs yc-gap" aria-label="Council lists">
        <button
          :for={{list, index} <- Enum.with_index(@draft.lists)}
          type="button"
          phx-click="select-topic"
          phx-value-index={index}
          class={["yc-btn", index == active_index(@draft) && "purple"]}
        >
          {index + 1}. {list.name}
        </button>
      </nav>
      <div class="yc-mobile-continue">
        <strong>{length(members(@draft))} selected</strong><.continue_button editing_reason={
          @editing_reason
        }>Continue →</.continue_button>
      </div>
      <div class="yc-grid yc-gap">
        <section>
          <form phx-change="search" phx-submit="search">
            <label for="person-search" class="yc-label">Find a person</label>
            <input
              id="person-search"
              class="yc-field"
              name="q"
              value={@query}
              placeholder="Search by name"
              phx-debounce="250"
            />
          </form>
          <div class="yc-between yc-gap">
            <h3>{if @query == "", do: "People to consider", else: "Search results"}</h3>
          </div>
          <% candidates = Enum.reject(@matches, &selected?(@draft, &1.id)) %>
          <p
            :if={@last_added_id && selected?(@draft, @last_added_id)}
            class="yc-help"
            role="status"
          >
            {@people[@last_added_id].name} added to your Council.
            <button
              type="button"
              class="yc-link"
              phx-click="edit-reason"
              phx-value-id={@last_added_id}
            >
              + Add a reason
            </button>
          </p>
          <div id="council-candidates" class="yc-list yc-gap-sm">
            <div
              :for={person <- candidates}
              id={"council-candidate-#{person.id}"}
              class="yc-list-item yc-between"
              phx-remove={
                JS.hide(
                  transition: {"yc-picker-fade", "yc-picker-visible", "yc-picker-hidden"},
                  time: 180
                )
              }
            >
              <.person person={person} subtitle={biography(person)} />
              <button
                type="button"
                class="yc-btn"
                phx-click="add-person"
                phx-value-id={person.id}
                phx-disable-with="Adding…"
                aria-label={"Add #{person.name} to your Council"}
              >
                + Add
              </button>
            </div>
            <p :if={candidates == []} class="yc-list-item">
              {cond do
                @matches != [] ->
                  "Everyone shown is already in your Council. Search for someone else."

                @query == "" ->
                  "Search by name to choose your first Council members."

                true ->
                  "No people found. Try another name."
              end}
            </p>
          </div>
          <p class="yc-help">
            Can’t find someone? Invite them after saving.
          </p>
        </section>
        <aside class="yc-stack">
          <div class="yc-panel">
            <div class="yc-between">
              <h3>Your {current_list(@draft).name} Council</h3>
              <span class="yc-badge purple">{length(members(@draft))} selected</span>
            </div>
            <div class="yc-stack yc-gap">
              <div :for={member <- members(@draft)} id={"council-member-#{member.author_id}"}>
                <div class="yc-between">
                  <.person person={@people[member.author_id]} />
                  <button
                    type="button"
                    class="yc-link muted"
                    phx-click="remove-person"
                    phx-value-id={member.author_id}
                    aria-label={"Remove #{@people[member.author_id].name}"}
                  >
                    Remove
                  </button>
                </div>
                <.reason_editor
                  member={member}
                  person={@people[member.author_id]}
                  editing_reason={@editing_reason}
                  reason_text={@reason_text}
                  reason_error={@reason_error}
                  autosave={!is_nil(@current_user)}
                />
              </div>
            </div>
            <p :if={members(@draft) == []} class="yc-gap">Your picks will appear here.</p>
            <hr class="yc-divider" />
            <p class="yc-help">
              Add an optional reason for each person. {if Map.get(
                                                            current_list(@draft),
                                                            :public,
                                                            false
                                                          ),
                                                          do: "These comments are public.",
                                                          else:
                                                            "These comments are private until you publish this list."}
            </p>
            <p class="yc-help">
              Your saved choices determine your vote. Publishing is optional.
            </p>
            <p :if={members(@draft) == []} class="yc-help">
              An empty list is skipped. We continue to the next matching list.
            </p>
            <.continue_button editing_reason={@editing_reason} class="yc-btn primary full yc-gap">
              {if @current_user, do: "Publish this list →", else: "Continue to Publish →"}
            </.continue_button>
          </div>
          <div class="yc-panel soft">
            <h3>You stay in control</h3>
            <p class="yc-gap-sm">
              When you haven’t voted, your vote follows your Council’s majority. Your direct vote overrides it.
            </p>
            <p class="yc-help">
              We check matching halls in order. Entries set to “All statements” apply regardless of hall. Only For and Against count toward a majority; abstentions and missing positions do not count.
            </p>
          </div>
        </aside>
      </div>
    </section>

    <section :if={@step == "join"} class="yc-grid equal">
      <div>
        <p class="yc-eyebrow">One last step to save</p>
        <h1>Keep your Council.</h1>
        <p class="yc-intro">
          Create an account to save your {length(members(@draft))} picks. Your reasons will come with you.
        </p>
        <div class="yc-panel soft yc-gap">
          <div class="yc-row">
            <.avatar :for={member <- members(@draft)} person={@people[member.author_id]} />
          </div>
          <p class="yc-gap-sm">
            Your Council stays private. You can publish separate, named lists of people.
          </p>
        </div>
        <.link patch={~p"/council?#{%{step: "pick"}}"} class="yc-link yc-gap">
          ← Back to my picks
        </.link>
      </div>
      <div class="yc-panel">
        <h2>Join YouCongress</h2>
        <p class="yc-gap-sm">Confirm your email to save your Council and start participating.</p>
        <YouCongressWeb.Components.LoginButtons.render
          class="yc-gap"
          email_action={:sign_up}
          pending_actions={pending(@draft, @ref)}
          return_to={~p"/council?#{%{step: "publish"}}"}
        />
        <p class="yc-help yc-gap">
          Already a member?
          <.link
            href={
              YouCongressWeb.ReturnTo.log_in_path(
                pending(@draft, @ref),
                ~p"/council?#{%{step: "publish"}}"
              )
            }
            class="yc-link"
          >
            Log in and keep my picks
          </.link>
        </p>
      </div>
    </section>

    <section :if={@step == "publish" && @current_user && editable_list?(@draft, @current_user)}>
      <div class="yc-success">
        <span class="yc-check">✓</span>
        <div>
          <strong>Your Council is saved.</strong>
          <p>Your Council stays private. Publishing a list is optional.</p>
        </div>
      </div>
      <p :if={@linked_list} class="yc-help yc-gap">
        Your Council uses <strong>{@linked_list.name}</strong>. Publishing makes this same list visible to everyone.
      </p>
      <h1 class="yc-gap-lg">Share a named list?</h1>
      <p class="yc-intro">
        Publish this list’s people and comments under a name you choose. Your Council stays private: public lists never show whether you use them to vote.
      </p>
      <form id="publish-council-list" phx-change="publish-change" phx-submit="publish-list">
        <label class="yc-label yc-gap" for="council-list-name">List name</label>
        <input
          id="council-list-name"
          value={@publish_fields.name}
          phx-debounce="300"
          class="yc-field"
          name="name"
          placeholder="e.g. People whose judgment I value"
          required
          maxlength="120"
        />
        <.list_slug_field
          owner={@current_user.author}
          slug={@publish_fields.slug}
          error={@publish_slug_error}
        />
        <div class="yc-panel soft yc-gap">
          <.person
            person={@current_user.author}
            subtitle={"#{people_count(length(members(@draft)))} · reasons included"}
          />
          <div class="yc-row yc-gap-sm">
            <.avatar :for={member <- members(@draft)} person={@people[member.author_id]} />
          </div>
        </div>
        <p class="yc-help yc-gap">
          People and comments in this list will be public. Later edits apply to the same list wherever it is used. Your Council assignment remains private.
        </p>
        <div class="yc-actions">
          <.link patch={~p"/council?#{%{step: "invite"}}"} class="yc-link muted">
            Skip for now
          </.link>
          <button class="yc-btn primary" phx-disable-with="Publishing…">
            Publish list & continue →
          </button>
        </div>
      </form>
    </section>

    <section :if={@step == "invite" && @current_user}>
      <div class="yc-success">
        <span class="yc-check">✓</span>
        <div>
          <strong>Your Council is set.</strong>
          <p>
            Your Council stays private. Invite others to choose their own.
          </p>
        </div>
      </div>
      <h1 class="yc-gap-lg">Who would you invite?</h1>
      <p class="yc-intro">
        Invite people whose judgment you value. Every new Council helps more people discover who to trust.
      </p>
      <div :if={@published_list} class="yc-panel soft yc-gap">
        <h3>Your public list: {@published_list.name}</h3>
        <.link
          navigate={YouCongressWeb.PeopleListPaths.public_path(@published_list)}
          class="yc-link yc-gap-sm"
        >
          View and share your list →
        </.link>
      </div>
      <form id="council-invites" phx-change="invite-change" phx-submit="invite">
        <div class="yc-panel yc-gap">
          <label class="yc-label" for="invite-link">Your personal invite link</label>
          <div class="yc-copy-row">
            <input class="yc-field" id="invite-link" readonly value={invite_url(@current_user)} />
            <button
              type="button"
              class="yc-btn primary"
              data-council-copy={invite_url(@current_user)}
            >
              Copy link
            </button>
          </div>
          <div class="yc-row yc-gap-sm">
            <.link href={share_href(:email, @current_user, @invite_note)} class="yc-btn">
              Email
            </.link>
            <.link href={share_href(:sms, @current_user, @invite_note)} class="yc-btn">
              Messages
            </.link>
            <.link
              href={share_href(:x, @current_user, @invite_note)}
              target="_blank"
              rel="noopener noreferrer"
              class="yc-btn"
            >
              X Post
            </.link>
            <button
              type="button"
              class="yc-btn"
              data-council-share={@invite_note <> "\n\n" <> invite_url(@current_user)}
            >
              Share…
            </button>
          </div>
          <label class="yc-label yc-gap" for="invite-note">
            Add a personal note <span class="yc-muted">· optional</span>
          </label>
          <textarea
            class="yc-field"
            name="note"
            id="invite-note"
            rows="3"
            maxlength="2000"
            phx-debounce="300"
          >{@invite_note}</textarea>
          <p class="yc-help">
            Friends can choose to share named public lists. Their Councils stay private.
          </p>
        </div>
        <div class="yc-panel yc-gap">
          <div class="yc-between">
            <label for="invite-emails" class="yc-label">Invite by email</label><small>One email. No follow-ups.</small>
          </div>
          <input
            class="yc-field"
            id="invite-emails"
            name="emails"
            value={@invite_emails}
            placeholder="Email addresses, separated by commas"
            maxlength="2600"
          />
          <p class="yc-help">Up to 10 people at once, 20 per day.</p>
          <button class="yc-btn purple yc-gap-sm" phx-disable-with="Queuing invitations…">
            Send invites
          </button>
        </div>
      </form>
      <div class="yc-panel soft yc-gap">
        <h3>Your invitations</h3>
        <p class="yc-gap-sm">{@joined} people joined through your invite link.</p>
        <div :for={invitation <- @invitations} class="yc-between yc-gap-sm">
          <span class="yc-break">{invitation.email}</span><span class="yc-badge">{invitation.status}</span>
        </div>
        <p :if={@invitations == []} class="yc-help">No email invitations sent yet.</p>
      </div>
      <div class="yc-actions">
        <.link patch={~p"/council"} class="yc-link muted">Skip for now</.link><.link
          patch={~p"/council"}
          class="yc-btn primary"
        >Go to My Council →</.link>
      </div>
    </section>

    <section :if={@step in ["mine", "votes"]}>
      <div class="yc-row">
        <h1>My Council</h1>
        <span class="yc-badge">
          <.icon name="hero-lock-closed" class="h-4 w-4" /> Only you can see these choices
        </span>
      </div>
      <p class="yc-intro">Choose whose judgment to follow when you haven’t voted.</p>
      <.council_tabs
        current_user={@current_user}
        active={if @step == "votes", do: :votes, else: :order}
      />
      <div :if={@step == "votes"} class="yc-list yc-gap">
        <div :for={vote <- @votes} class="yc-list-item yc-between">
          <.link navigate={~p"/p/#{vote.statement.slug}"} class="yc-name">
            {vote.statement.title}
          </.link>
          <span class="yc-badge">
            {answer(vote.answer)} · {if vote.direct, do: "direct vote", else: "via your Council"}
          </span>
        </div>
        <p :if={@votes == []} class="yc-list-item">
          No votes yet.
          <.link navigate={~p"/explore"} class="yc-link">Explore statements →</.link>
        </p>
      </div>
      <div :if={@step == "mine"} class="yc-gap">
        <div class="yc-panel tint">
          <h2>How your Council decides</h2>
          <p class="yc-gap-sm">
            We check matching halls from top to bottom. Entries set to “All statements” apply regardless of hall.
          </p>
          <p class="yc-gap-sm">
            The first list with more For than Against, or more Against than For, decides. Ties move to the next list; your direct vote always takes priority.
          </p>
        </div>
        <div class="yc-between yc-gap">
          <h2>Your order</h2>
          <span :if={!@save_error} class="yc-entry-saved" role="status">✓ All changes saved</span>
        </div>
        <div class="yc-order-table-wrap yc-gap-sm">
          <table class="yc-order-table" aria-label="Council order">
            <thead>
              <tr>
                <th scope="col">Order</th>
                <th scope="col">Hall</th>
                <th scope="col">List to use</th>
                <th scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <tr
                :for={{list, index} <- Enum.with_index(@draft.lists)}
                id={"topic-list-#{list.id}"}
                class={["yc-order-row", list.fallback && "yc-order-fallback"]}
              >
                <td class="yc-order-number">
                  <span class="yc-mobile-label">Order </span>{index + 1}
                </td>
                <td class="yc-order-hall">
                  <span class="yc-mobile-label">Hall</span>
                  <.live_component
                    module={YouCongressWeb.Components.CouncilHallSelector}
                    id={"council-hall-#{list.id}"}
                    list_id={list.id}
                    hall_id={list.hall_id}
                    halls={@halls}
                    fixed={true}
                  />
                </td>
                <td class="yc-order-list">
                  <span class="yc-mobile-label">List to use</span>
                  <%= if source = @linked_lists[list.id] do %>
                    <.link
                      navigate={YouCongressWeb.PeopleListPaths.public_path(source)}
                      class="yc-link"
                    >
                      {source.name}
                    </.link>
                    <p class="yc-help">
                      {if source.public, do: "Public", else: "Private"} · By {if source.author_id ==
                                                                                   @current_user.author_id,
                                                                                 do: "you",
                                                                                 else:
                                                                                   @list_owners[
                                                                                     source.author_id
                                                                                   ].name} · {people_count(
                        length(list.members)
                      )}
                    </p>
                    <p :if={list.members == []} class="yc-help">
                      No eligible people yet · Skipped
                    </p>
                  <% else %>
                    <strong>List unavailable</strong>
                    <p class="yc-help">Skipped until you choose another list</p>
                  <% end %>
                </td>
                <td class="yc-order-actions">
                  <div class="yc-row">
                    <%= if list.fallback do %>
                      <span class="yc-badge">Always last</span>
                    <% else %>
                      <button
                        class="yc-btn"
                        phx-click="move-list"
                        phx-value-id={list.id}
                        phx-value-direction="up"
                        disabled={index == 0}
                        aria-label={"Move #{list.name} up"}
                      >
                        ↑
                      </button>
                      <button
                        class="yc-btn"
                        phx-click="move-list"
                        phx-value-id={list.id}
                        phx-value-direction="down"
                        disabled={index == length(@draft.lists) - 2}
                        aria-label={"Move #{list.name} down"}
                      >
                        ↓
                      </button>
                    <% end %>
                    <.link patch={~p"/council?#{%{step: "pick", list: list.id}}"} class="yc-btn">
                      Edit entry
                    </.link>
                    <details :if={!list.fallback} class="yc-order-menu">
                      <summary aria-label={"More options for entry #{index + 1}"}>⋯</summary>
                      <div class="yc-order-menu-content">
                        <button
                          class="yc-link"
                          phx-click="remove-list"
                          phx-value-id={list.id}
                          data-confirm="Remove this entry from your Council? The list itself will be kept."
                        >
                          Remove entry
                        </button>
                      </div>
                    </details>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="yc-row yc-gap">
          <button phx-click="toggle-add-hall" class="yc-btn">+ Add another hall</button>
          <span class="yc-help">
            You can use the same hall more than once, including All statements.
          </span>
        </div>
        <details class="yc-order-example yc-gap-sm">
          <summary class="yc-link">See an example</summary>
          <p class="yc-help yc-gap-sm">
            With the default order, a statement tagged impact-on-labor skips ai-governance. We check your impact-on-labor list, then All statements if that list is tied or has no For or Against votes. Abstentions and missing positions do not count. If no list decides, no Council vote is cast.
          </p>
        </details>
        <div :if={@show_add_hall} class="yc-panel yc-gap">
          <h3>Add a Council entry</h3>
          <p class="yc-help">
            Choose an existing hall or All statements. Repeated halls let you try different lists in order.
          </p>
          <.live_component
            module={YouCongressWeb.Components.CouncilHallSelector}
            id="council-new-hall"
            list_id={:new}
            hall_id={@new_hall_id}
            halls={@halls}
            fixed={false}
          />
          <form id="add-council-hall" phx-submit="add-hall" class="yc-gap-sm">
            <input type="hidden" name="hall_id" value={@new_hall_id || "general"} />
            <label for="council-new-name" class="yc-label">List title (optional)</label>
            <input
              id="council-new-name"
              name="name"
              class="yc-field"
              placeholder="For example: My most trusted people"
              maxlength="120"
            />
            <button class="yc-btn purple yc-gap-sm">Add list</button>
          </form>
        </div>
        <p class="yc-help yc-gap">
          <.icon name="hero-lock-closed" class="h-4 w-4" />
          Public lists can be shared. Which lists you use here stays private.
        </p>
      </div>
    </section>
    <p id="council-copy-status" class="yc-help" role="status" phx-update="ignore"></p>
  </div>
</div>
