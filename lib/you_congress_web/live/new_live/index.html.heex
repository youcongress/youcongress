<div class="text-center pt-2 pb-4">
  <div class="leading-8 text-gray-600">
    <h1 class="text-2xl font-bold">Newest Opinions</h1>
    <p class="text-lg">
      The most recent sourced opinions, ordered by the date they were stated, together with each author's statements and votes.
    </p>
  </div>
</div>

<ul
  id="new-opinion-cards"
  phx-viewport-bottom={@has_more_cards && "load-more"}
  class="space-y-4 pt-4"
>
  <li
    :for={card <- @cards}
    id={"new-card-#{card.id}"}
    class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden"
  >
    <div class="p-4 md:p-5">
      <div class="mb-3">
        <h2 class="text-lg md:text-xl font-medium text-gray-900">
          <.link href={~p"/p/#{card.statement.slug}"} class="hover:text-indigo-600">
            {card.statement.title}
          </.link>
        </h2>
        <p :if={card.statement.opinions_count > 0} class="text-sm text-gray-500 mt-1">
          {card.statement.opinions_count} {if card.statement.opinions_count == 1,
            do: "opinion",
            else: "opinions"}
        </p>
      </div>

      <div class="border-t border-gray-100 pt-4 mt-2">
        <.live_component
          module={VoteComponent}
          id={"newest-vote-#{card.id}"}
          vote={card.vote}
          author={card.vote.author}
          statement={card.statement}
          current_user={@current_user}
          show_vote={true}
          show_opinion={true}
          liked={card.vote.opinion && card.vote.opinion.id in @liked_opinion_ids}
          liked_opinion_ids={@liked_opinion_ids}
          delegating?={card.vote.author_id in @delegate_ids}
          delegable={true}
          regenerating_opinion_id={nil}
          page={:statements_index}
        />
      </div>

      <% votes = author_votes(@author_votes, card.vote.author_id, card.statement.id) %>
      <div :if={votes != []} class="border-t border-gray-100 pt-4 mt-2">
        <div class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">
          {author_name(card.vote.author)} · statements &amp; votes
        </div>
        <ul class="space-y-1.5">
          <li
            :for={vote <- votes}
            class="text-sm flex items-start gap-2"
            id={"author-vote-#{card.id}-#{vote.id}"}
          >
            <span class={answer_badge(vote.answer)}>
              {answer_label(vote.answer)}
            </span>
            <span>
              <.link
                href={~p"/p/#{vote.statement.slug}"}
                class="text-gray-700 hover:text-indigo-600"
              >
                {vote.statement.title}
              </.link>
              <%= if vote.opinion && Opinion.display_date(vote.opinion) do %>
                <span class="text-xs text-gray-400">({Opinion.display_date(vote.opinion)})</span>
              <% end %>
            </span>
          </li>
        </ul>
        <div class="pt-2">
          <.link
            href={author_path(card.vote.author)}
            class="text-xs text-gray-500 hover:text-indigo-600"
          >
            See all of {author_name(card.vote.author)}'s statements &amp; votes
          </.link>
        </div>
      </div>
    </div>
  </li>
</ul>

<div :if={@cards == []} class="mt-5 text-xl text-center">
  No opinions yet.
</div>
