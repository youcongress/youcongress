<h1 class="text-2xl font-bold">
  Settings
</h1>

<div class="pt-4">
  <.link
    href={~p"/log_out"}
    method="delete"
    class="bg-blue-600 text-white font-bold py-2 px-4 rounded hover:bg-blue-700 mt-4"
  >
    Log out
  </.link>
</div>
<.simple_form for={@form} id="author-form" phx-change="validate" phx-submit="save">
  <.input
    field={@form[:username]}
    label="YouCongress username"
    placeholder="your_username"
  />
  <p class="-mt-4 text-sm text-zinc-500">
    Your profile URL will be youcongress.org/@your_username. Use 5–15 lowercase letters,
    numbers, or underscores.
  </p>
  <p class="mt-2 text-sm text-zinc-500">
    Three- and four-character usernames are reserved as a special perk for YouCongress donors
    and supporters. Interested? Email <.link
      href="mailto:hector@youcongress.org"
      class="font-medium text-blue-600 hover:underline"
    >
      hector@youcongress.org
    </.link>.
  </p>

  <%= if :name in profile_allowed_fields(@current_user) do %>
    <.input field={@form[:name]} label="Name" />
    <.input field={@form[:bio]} label="One-line bio" />
  <% else %>
    <div>
      <ul class="text-sm">
        <li>Name: {@current_user.author.name}</li>
        <li>Bio: {@current_user.author.bio}</li>
      </ul>

      <div class="pt-2">
        You can <strong>change your name</strong>
        and bio on X/Twitter. Then, log out & log in on YouCongress again and they will be updated.
      </div>
    </div>
  <% end %>

  <%= if phone_location_locked?(@current_user) do %>
    <div :if={@profile_country_name} class="mt-4 text-sm">
      <div class="font-semibold text-zinc-800">Location</div>
      <div class="text-zinc-700">{@profile_country_name}</div>
      <div class="text-xs text-zinc-500">
        Set from your verified phone number.
      </div>
    </div>
  <% else %>
    <.input
      type="select"
      field={@form[:country_id]}
      label="Country"
      prompt="Select your country"
      options={@country_options}
    />
    <div class="text-sm">
      <.link
        navigate={~p"/sign_up?#{%{phone: "true", return_to: "/settings"}}"}
        class="font-semibold text-blue-600 hover:underline"
      >
        Verify with phone
      </.link>
      <span class="text-zinc-500">
        to show you're likely a real person and update your location.
      </span>
    </div>
  <% end %>

  <:actions>
    <.button phx-disable-with="Saving...">Save</.button>
  </:actions>
</.simple_form>

<section class="mt-10 border-t border-zinc-200 pt-8">
  <h2 class="text-xl font-semibold">Password login</h2>
  <p class="mt-1 text-sm text-zinc-600">
    <%= if @current_user.hashed_password do %>
      A password is set for your account. You can change it using a secure email link.
    <% else %>
      A password is optional. You can create one if you also want to log in with email and password.
    <% end %>
  </p>
  <button
    type="button"
    phx-click="send_password_setup_instructions"
    class="mt-3 rounded-md bg-white px-4 py-2 text-sm font-semibold text-zinc-700 ring-1 ring-inset ring-zinc-300 hover:bg-zinc-50"
  >
    {if @current_user.hashed_password, do: "Change password", else: "Set a password"}
  </button>
</section>

<section class="mt-10 border-t border-zinc-200 pt-8">
  <h2 class="text-xl font-semibold">Email updates</h2>
  <p class="mt-1 text-sm text-zinc-600">
    Receive news and product updates from YouCongress.
  </p>
  <button
    :if={!@current_user.newsletter}
    type="button"
    phx-click="subscribe_newsletter"
    class="mt-3 rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700"
  >
    Subscribe
  </button>
  <.link
    :if={@current_user.newsletter}
    href="https://youcongress.substack.com"
    target="_blank"
    rel="noopener noreferrer"
    class="mt-3 inline-flex rounded-md bg-white px-4 py-2 text-sm font-semibold text-zinc-700 ring-1 ring-inset ring-zinc-300 hover:bg-zinc-50"
  >
    Manage newsletter on Substack
  </.link>
</section>

<section class="mt-10">
  <h2 class="text-xl font-semibold">API keys</h2>
  <p class="mt-1 text-sm text-zinc-600">
    Create API keys to access the YouCongress API. Choose a descriptive name and whether the
    key should be read-only or allow write operations. Send the key only in an
    <code>Authorization: Bearer YOUR_API_KEY</code>
    header, never in a URL.
  </p>

  <%= if @last_api_key_token do %>
    <div class="mt-4 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
      <p class="font-semibold">Copy your new API key now:</p>
      <p class="mt-2 font-mono text-base">{@last_api_key_token}</p>
      <p class="mt-1">This is the only time the full key will be shown.</p>
    </div>
  <% end %>

  <.simple_form for={@api_key_form} id="api-key-form" phx-submit="create_api_key" class="mt-4">
    <.input field={@api_key_form[:name]} label="Name" />
    <.input
      type="select"
      field={@api_key_form[:scope]}
      label="Access level"
      options={[{"Read-only", :read}, {"Read & write", :write}]}
    />

    <:actions>
      <.button phx-disable-with="Creating...">Create API key</.button>
    </:actions>
  </.simple_form>

  <div class="mt-6 overflow-x-auto rounded-md border border-zinc-200">
    <%= if Enum.empty?(@api_keys) do %>
      <div class="p-4 text-sm text-zinc-600">No API keys yet.</div>
    <% else %>
      <table class="min-w-full divide-y divide-zinc-200 text-sm">
        <thead class="bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">
          <tr>
            <th class="px-4 py-2">Name</th>
            <th class="px-4 py-2">Access</th>
            <th class="px-4 py-2">API key</th>
            <th class="px-4 py-2">Created</th>
            <th class="px-4 py-2"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100 bg-white text-zinc-800">
          <%= for api_key <- @api_keys do %>
            <tr>
              <td class="px-4 py-3 font-medium">{api_key.name}</td>
              <td class="px-4 py-3">{human_scope(api_key.scope)}</td>
              <td class="px-4 py-3 font-mono text-xs">{masked_token(api_key)}</td>
              <td class="px-4 py-3 text-zinc-500">
                {Calendar.strftime(api_key.inserted_at, "%Y-%m-%d %H:%M")}
              </td>
              <td class="px-4 py-3 text-right">
                <button
                  type="button"
                  phx-click="revoke_api_key"
                  phx-value-id={api_key.id}
                  data-confirm="Revoke this API key? Clients using it will immediately lose access."
                  class="font-semibold text-rose-600 hover:text-rose-800"
                >
                  Revoke
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</section>
