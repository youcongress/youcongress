<div class="py-8 space-y-6">
  <header class="space-y-3">
    <p class="font-semibold text-indigo-700">TRUST NETWORK</p>
    <h1 class="text-3xl font-bold">
      {case @live_action do
        :communities -> "Participating communities"
        :compare -> "Compare trust lists"
        :recommendations -> "Recommendations"
        :snapshot -> "Published trust snapshot"
        :metrics -> "Trust Network evaluation"
        _ -> "Who do participants trust?"
      end}
    </h1>
    <nav class="flex flex-wrap gap-4 text-sm text-indigo-700">
      <.link navigate={~p"/council"}>My Council</.link>
      <.link :if={YouCongress.Accounts.admin?(@current_user)} navigate={~p"/trust"}>
        Trust List
      </.link>
    </nav>
  </header>
  <section :if={@live_action == :rankings} class="space-y-5">
    <form phx-change="filters" class="grid sm:grid-cols-2 gap-4 rounded-lg bg-gray-50 p-4">
      <label>
        Scope<select name="scope" class="block w-full rounded border-gray-300">
<option
            :for={{value, label} <- @scopes}
            value={value}
            selected={value == @scope}
          >{label}</option>
</select>
      </label>
      <label>
        Community<select name="community" class="block w-full rounded border-gray-300">
<option value="">All YouCongress</option>
<option
            :for={community <- @communities}
            value={community.id}
            selected={to_string(community.id) == @filters["community"]}
          >{community.name}</option>
</select>
      </label>
      <label>
        Nominators' country<select name="nominators" class="block w-full rounded border-gray-300">
<option value="">All countries</option>
<option
            value="unknown"
            selected={@filters["nominators"] == "unknown"}
          >Unknown</option>
<option
            :for={{name, id} <- @countries}
            value={id}
            selected={to_string(id) == @filters["nominators"]}
          >{name}</option>
</select>
      </label>
      <label>
        Nominees' country<select name="nominees" class="block w-full rounded border-gray-300">
<option value="">All countries</option>
<option
            value="unknown"
            selected={@filters["nominees"] == "unknown"}
          >Unknown</option>
<option
            :for={{name, id} <- @countries}
            value={id}
            selected={to_string(id) == @filters["nominees"]}
          >{name}</option>
</select>
      </label>
    </form>
    <p>
      <strong>{@result.participants}</strong>
      participants nominated in this scope. Nominee filters do not change this audience.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b">
            <th class="p-3">Rank</th>
            <th class="p-3">Person</th>
            <th class="p-3">Nominations</th>
            <th class="p-3">Share</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @result.rows} class="border-b">
            <td class="p-3">{row.rank}</td>
            <td class="p-3">
              <.link href={~p"/a/#{row.author_id}"}>{row.name}</.link>
              <.live_component
                :if={!@current_user || @current_user.author_id != row.author_id}
                module={YouCongressWeb.Components.CouncilBookmark}
                id={"ranking-council-#{row.author_id}"}
                author_id={row.author_id}
                name={row.name}
                current_user={@current_user}
              />
            </td>
            <td class="p-3">{row.count}</td>
            <td class="p-3">{row.share}%</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p :if={@result.rows == []}>No nominations match these filters yet.</p>
    <p class="text-sm text-gray-600">
      These results describe participating nominators, not an entire population. Repeated selections within a scope count once. Multiple nominations mean shares may total more than 100%. General is independent of specialist scopes.
    </p>
    <.link href={~p"/trust/#{@scope}/export.csv?#{@filters}"} class="text-indigo-700">
      Download these results
    </.link>
    <form :if={admin?(@current_user)} phx-submit="snapshot" class="flex gap-3">
      <label>
        Snapshot title<input
          name="title"
          required
          maxlength="180"
          class="block rounded border-gray-300"
        />
      </label>
      <button class="rounded border px-3">Publish dated snapshot</button>
    </form>
    <div :if={@snapshots != []}>
      <h2 class="text-xl font-semibold">Dated snapshots</h2>
      <.link
        :for={snapshot <- @snapshots}
        navigate={~p"/trust/snapshots/#{snapshot.id}"}
        class="block py-2 text-indigo-700"
      >
        {snapshot.title} · {NaiveDateTime.to_date(snapshot.inserted_at)}
      </.link>
    </div>
  </section>
  <section :if={@live_action == :compare} class="space-y-4">
    <form phx-change="compare" class="space-y-4">
      <label>
        Scope<select name="scope" class="rounded border-gray-300">
<option
            :for={{value, label} <- @scopes}
            value={value}
            selected={value == @scope}
          >{label}</option>
</select>
      </label>
      <div class="grid md:grid-cols-2 gap-4">
        <div
          :for={{group, i} <- Enum.with_index(@comparisons)}
          class="rounded-lg border p-4 space-y-3"
        >
          <h2 class="font-semibold">Group {i + 1}</h2>
          <label>
            Community<select
              name={"groups[#{i}][community]"}
              class="block w-full rounded border-gray-300"
            >
<option value="">All YouCongress</option>
<option
                :for={c <- @communities}
                value={c.id}
                selected={to_string(c.id) == group.filters["community"]}
              >{c.name}</option>
</select>
          </label>
          <label :for={
            {key, label} <- [
              {"nominators", "Nominators' country"},
              {"nominees", "Nominees' country"}
            ]
          }>
            {label}<select
              name={"groups[#{i}][#{key}]"}
              class="block w-full rounded border-gray-300"
            >
<option value="">All countries</option>
<option
                value="unknown"
                selected={group.filters[key] == "unknown"}
              >Unknown</option>
<option
                :for={{name, id} <- @countries}
                value={id}
                selected={to_string(id) == group.filters[key]}
              >{name}</option>
</select>
          </label>
          <p>{group.result.participants} participants</p>
          <ol class="space-y-2">
            <li :for={row <- group.result.rows}>
              {row.rank}. {row.name}: {row.share}% · {row.count}
            </li>
          </ol>
        </div>
      </div>
    </form>
    <button
      :if={length(@comparisons) < 8}
      phx-click="add-comparison"
      class="rounded border px-4 py-2"
    >
      Add comparison group
    </button>
    <p class="text-sm text-gray-600">
      Each group has its own participant denominator. Community totals are never added together.
    </p>
  </section>
  <section :if={@live_action == :communities} class="space-y-5">
    <p>
      Joining includes your saved council nominations in this community's trust lists. Results describe participating readers; external membership is not verified. Leaving removes your nominations from its current rankings.
    </p>
    <div class="grid md:grid-cols-2 gap-4">
      <article :for={community <- @communities} class="rounded-lg border p-5 space-y-3">
        <h2 class="text-xl font-semibold">
          <.link navigate={~p"/communities/#{community.id}"}>{community.name}</.link>
        </h2>
        <p>{community.description}</p>
        <div class="flex flex-wrap gap-3">
          <.link
            :for={{scope, label} <- @scopes}
            navigate={~p"/trust/#{scope}?#{%{community: community.id}}"}
            class="text-indigo-700 text-sm"
          >
            {label}
          </.link>
        </div>
        <button
          :if={community.id not in @memberships}
          phx-click="join"
          phx-value-id={community.id}
          class="rounded bg-indigo-700 px-4 py-2 text-white"
        >
          Join community
        </button>
        <button
          :if={community.id in @memberships}
          phx-click="leave"
          phx-value-id={community.id}
          class="rounded border px-4 py-2"
        >
          Leave community
        </button>
      </article>
    </div>
    <p :if={@communities == []}>No communities have been enabled yet.</p>
    <div :if={@community} class="rounded border p-5 space-y-4">
      <h2 class="text-xl font-semibold">{@community.name}: participant positions</h2>
      <.link href={~p"/h/#{@community.name}"} class="text-indigo-700">
        Browse this hall's statements
      </.link>
      <p :for={row <- @community_results}>
        <.link href={~p"/p/#{row.slug}"}>{row.title}</.link>
        · {if row.direct, do: "Direct", else: "Delegated"} {row.answer}: {row.count}
      </p>
      <form
        :if={TrustNetwork.organizer?(@current_user, @community)}
        phx-submit="add-statement"
        class="flex gap-3"
      >
        <label>
          Add an existing statement by ID<input
            type="number"
            min="1"
            name="statement_id"
            required
            class="block rounded border-gray-300"
          />
        </label>
        <button class="border rounded px-3">Add to hall</button>
      </form>
      <form
        :if={TrustNetwork.organizer?(@current_user, @community)}
        phx-submit="create-statement"
        class="space-y-3"
      >
        <label>
          New proposal or claim<input
            name="title"
            required
            maxlength="500"
            class="block w-full rounded border-gray-300"
          />
        </label>
        <button class="rounded border px-3 py-2">Create in this community</button>
      </form>
      <.link
        :if={TrustNetwork.organizer?(@current_user, @community)}
        href={~p"/reconsider/new"}
        class="block text-indigo-700"
      >
        Create a Reconsider page
      </.link>
    </div>
    <form
      :if={admin?(@current_user)}
      phx-submit="enable-community"
      class="rounded border p-5 space-y-3"
    >
      <h2 class="font-semibold">Configure participating community</h2>
      <label>
        Hall<select name="hall_id" class="block rounded border-gray-300">
<option
            :for={hall <- @admin_halls}
            value={hall.id}
          >{hall.name}</option>
</select>
      </label>
      <label>
        Organizer account ID<input
          name="organizer_id"
          type="number"
          min="1"
          class="block rounded border-gray-300"
        />
      </label>
      <label class="block">
        <input type="checkbox" name="enabled" value="true" />
        Participation confirmed; enable community
      </label>
      <button class="rounded border px-4 py-2">Save community</button>
    </form>
  </section>
  <section :if={@live_action == :recommendations} class="space-y-5">
    <p>
      Public recommendations are independent of your council. They affect neither delegation nor public rankings unless you also save the person in a council list.
    </p>
    <h2 :if={@public_author} class="text-xl font-semibold">
      {@public_author.name}'s recommendations
    </h2>
    <article :for={item <- @recommendations} class="rounded border p-4 space-y-2">
      <h3 class="font-semibold">
        <.link href={~p"/a/#{item.record.nominee_id}"}>{item.name}</.link> · {item.record.scope}
      </h3>
      <p>{item.record.reason}</p>
      <.link
        :if={item.record.source_url not in [nil, ""]}
        href={item.record.source_url}
        rel="noopener noreferrer"
        class="text-indigo-700"
      >
        Start here
      </.link>
      <p :if={!item.record.published} class="text-sm">Private draft</p>
      <button
        :if={own_recommendations?(@current_user, @public_author)}
        phx-click="delete-recommendation"
        phx-value-id={item.record.id}
        class="block text-red-700 text-sm"
      >
        Delete recommendation
      </button>
    </article>
    <div
      :if={
        @current_user && (!@public_author || own_recommendations?(@current_user, @public_author))
      }
      class="space-y-4"
    >
      <form phx-change="search-people">
        <label>
          Find a person<input
            name="q"
            value={@person_query}
            phx-debounce="300"
            class="block w-full rounded border-gray-300"
          />
        </label>
      </form>
      <form phx-submit="recommend" class="rounded border p-5 space-y-4">
        <h2 class="text-xl font-semibold">Create or update a recommendation</h2>
        <label>
          Person<select name="nominee_id" required class="block rounded border-gray-300">
<option value="">Choose a search result</option>
<option
              :for={person <- @people}
              value={person.id}
            >{person.name}</option>
</select>
        </label>
        <label>
          Scope<select name="scope" class="block rounded border-gray-300">
<option
              :for={{scope, label} <- @scopes}
              value={scope}
            >{label}</option>
</select>
        </label>
        <label class="block">
          Why this person?<textarea
            name="reason"
            maxlength="5000"
            class="block w-full rounded border-gray-300"
          >
</textarea>
        </label>
        <label class="block">
          Where should readers start?<input
            type="url"
            name="source_url"
            class="block w-full rounded border-gray-300"
          />
        </label>
        <label class="block">
          <input type="checkbox" name="published" value="true" />
          Publish this recommendation and reason
        </label>
        <label class="block">
          <input type="checkbox" name="add_to_council" value="true" />
          Also add to my first list in this scope (changes delegation and rankings)
        </label>
        <button class="rounded bg-indigo-700 px-4 py-2 text-white">Save recommendation</button>
      </form>
    </div>
  </section>
  <section :if={@live_action == :snapshot && @snapshot} class="space-y-4">
    <h2 class="text-xl font-semibold">{@snapshot.title}</h2>
    <p>
      Published {NaiveDateTime.to_date(@snapshot.inserted_at)} · Historical snapshot · {@snapshot.result[
        "participants"
      ]} participants
    </p>
    <p :for={row <- @snapshot.result["rows"]}>
      {row["rank"]}. {row["name"]}: {row["count"]} nominations · {row["share"]}%
    </p>
    <.link href={~p"/trust/snapshots/#{@snapshot.id}/export.csv"} class="text-indigo-700">
      Download snapshot
    </.link>
  </section>
  <section :if={@live_action == :metrics && @metrics} class="space-y-4">
    <h2 class="font-semibold">Participation and review</h2>
    <p>{@metrics.councils} councils · {@metrics.published} published councils</p>
    <p :for={{status, count} <- @metrics.requests}>{status}: {count} evidence requests</p>
    <p>
      Reconsider reports changes in participants' stated positions, not causal effects of content. Participation, explanation views, saves, and referrals are measured only with analytics consent.
    </p>
  </section>
  <p :if={!@current_user && @live_action in [:recommendations, :communities]}>
    <.link href={~p"/log_in"} class="text-indigo-700">Sign in</.link> to participate.
  </p>
</div>
