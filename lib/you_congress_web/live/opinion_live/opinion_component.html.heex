<div class="pb-4">
  <div>
    <div class="flex justify-between">
      <div class="flex items-center space-x-2">
        <div class="shrink-0">
          <.link
            href={AuthorLive.Show.author_path(@opinion.author)}
            class="relative top-1 inline-flex cursor-pointer"
          >
            <OpinionComponent.avatar_icon
              is_human={!@opinion.twin}
              name={@opinion.author.name}
              profile_image_url={@opinion.author.profile_image_url}
            />
          </.link>
        </div>
        <div>
          <div>
            <strong>
              <.link href={AuthorLive.Show.author_path(@opinion.author)}>
                {@opinion.author.name}
              </.link>
            </strong>
          </div>
          <div class="text-sm">
            {@opinion.author.bio || @opinion.author.description}
          </div>
        </div>
      </div>
      <QuoteMenu.render
        author={@opinion.author}
        id={@opinion.id}
        opinion={@opinion}
        current_user={@current_user}
        statement={@statement}
        page={@page}
      />
    </div>
  </div>

  <div class="pt-2">
    <%= if Opinion.quote?(@opinion) && !@opinion.twin do %>
      <blockquote cite={@opinion.source_url} class="inline">{@opinion.content}</blockquote>
    <% else %>
      {@opinion.content}
    <% end %>
    <%= if Opinion.quote?(@opinion) do %>
      <.live_component
        module={YouCongressWeb.Components.VerificationBadge}
        id={"#{@opinion.id}-#{if @statement, do: @statement.id}"}
        opinion={@opinion}
        current_user={@current_user}
        link_to_opinion={@page != :opinion_show}
      />
      <%= cond do %>
        <% Opinion.has_source_url?(@opinion) and !(@opinion.source_text && @page == :opinion_show) -> %>
          <span class="text-xs">
            <a href={@opinion.source_url} target="_blank" class="underline">source</a>
          </span>
        <% is_nil(@opinion.source_url) and @page != :opinion_show -> %>
          <span class="text-xs">
            <.link href={~p"/c/#{@opinion.id}"} class="underline">source</.link>
          </span>
        <% true -> %>
      <% end %>
      <%= if Opinion.display_date(@opinion) do %>
        <span class="text-xs text-gray-500">({Opinion.display_date(@opinion)})</span>
      <% end %>
    <% end %>
    <%= if @opinion.source_text && @page == :opinion_show do %>
      <div class="mt-2 border-l-2 border-gray-200 pl-3 text-sm text-gray-600">
        <div class="font-semibold">Source:</div>
        <%= if Opinion.has_source_url?(@opinion) do %>
          <a
            href={@opinion.source_url}
            target="_blank"
            class="whitespace-pre-line underline hover:text-gray-800"
            phx-no-format
          >{@opinion.source_text}</a>
        <% else %>
          <div class="whitespace-pre-line">{@opinion.source_text}</div>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="flex justify-between pt-4 pb-4">
    <div>
      <span class="pr-2">
        <OpinionComponent.like_icon opinion={@opinion} liked={@liked} target={@myself} />
      </span>
      <span :if={@opinable} class="pr-2">
        <OpinionComponent.comment_icon opinion={@opinion} />
      </span>
      <OpinionComponent.x_icon
        author={@opinion.author}
        statement={@statement}
        opinion={@opinion}
        current_user={@current_user}
      />
      <span class="text-xs text-gray-500 pl-3">
        {TimeAgo.short_time(@opinion.inserted_at)}
      </span>
    </div>
    <div>
      <%= if @delegable && (!@current_user || (@opinion.author_id != @current_user.author_id)) do %>
        <div>
          <Tooltip.delegation assigns={assigns} />
          <.live_component
            module={YouCongressWeb.Components.CouncilBookmark}
            id={"opinion-council-#{@id}"}
            author_id={@opinion.author_id}
            name={@opinion.author.name || "this person"}
            current_user={@current_user}
            saved={@delegating}
          />
        </div>
      <% end %>
    </div>
  </div>
</div>
